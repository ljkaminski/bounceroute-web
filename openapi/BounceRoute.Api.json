{
  "openapi": "3.1.1",
  "info": {
    "title": "BounceRoute.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/route": {
      "get": {
        "tags": [
          "Route"
        ],
        "summary": "Every job for one day, in order. Defaults to today.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteDayDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": [
          "Route"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/jobs/{id}/complete": {
      "post": {
        "tags": [
          "Route"
        ],
        "summary": "Marks a job done by a crew member.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}/reopen": {
      "post": {
        "tags": [
          "Route"
        ],
        "summary": "Undoes a mistaken Mark complete.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCardDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/booking-items/{id}/loaded": {
      "put": {
        "tags": [
          "Route"
        ],
        "summary": "Checks or unchecks an item on the loading list.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetItemLoadedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingItemDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "summary": "Bookings whose setup falls between two dates (inclusive). Defaults to the next 14 days.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingSummaryDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Creates a booking with its setup and pickup jobs.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveBookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "get": {
        "tags": [
          "Bookings"
        ],
        "operationId": "GetBooking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Bookings"
        ],
        "summary": "Replaces a booking's details, schedule, crew, and items. Loaded checks are kept for items still on it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveBookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/crew": {
      "get": {
        "tags": [
          "Crew"
        ],
        "parameters": [
          {
            "name": "includeInactive",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CrewMemberDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Crew"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveCrewMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrewMemberDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/crew/{id}": {
      "put": {
        "tags": [
          "Crew"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveCrewMemberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CrewMemberDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/crew/units": {
      "get": {
        "tags": [
          "Crew"
        ],
        "summary": "Units on completed jobs per crew member between two dates (inclusive). Defaults to this weekend, Friday through Monday.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitTotalsReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookingDto": {
        "required": [
          "id",
          "jobNumber",
          "customerName",
          "phone",
          "street",
          "cityStateZip",
          "surface",
          "siteNotes",
          "setup",
          "pickup",
          "items"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "jobNumber": {
            "type": "integer",
            "format": "int32"
          },
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "cityStateZip": {
            "type": "string"
          },
          "surface": {
            "$ref": "#/components/schemas/Surface"
          },
          "siteNotes": {
            "type": "string"
          },
          "setup": {
            "$ref": "#/components/schemas/JobScheduleDto"
          },
          "pickup": {
            "$ref": "#/components/schemas/JobScheduleDto"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDto"
            }
          }
        }
      },
      "BookingItemDto": {
        "required": [
          "id",
          "name",
          "isUnit",
          "isLoaded"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "isUnit": {
            "type": "boolean"
          },
          "isLoaded": {
            "type": "boolean"
          }
        }
      },
      "BookingSummaryDto": {
        "required": [
          "id",
          "jobNumber",
          "customerName",
          "street",
          "setupAt",
          "pickupAt",
          "unitCount",
          "isComplete"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "jobNumber": {
            "type": "integer",
            "format": "int32"
          },
          "customerName": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "setupAt": {
            "type": "string",
            "format": "date-time"
          },
          "pickupAt": {
            "type": "string",
            "format": "date-time"
          },
          "unitCount": {
            "type": "integer",
            "format": "int32"
          },
          "isComplete": {
            "type": "boolean"
          }
        }
      },
      "CompleteJobRequest": {
        "required": [
          "crewMemberId"
        ],
        "type": "object",
        "properties": {
          "crewMemberId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CrewMemberDto": {
        "required": [
          "id",
          "name",
          "initials",
          "role",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CrewSummaryDto": {
        "required": [
          "id",
          "name",
          "initials"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          }
        }
      },
      "CrewUnitTotalsDto": {
        "required": [
          "crewMemberId",
          "name",
          "initials",
          "jobs",
          "setupUnits",
          "pickupUnits",
          "totalUnits"
        ],
        "type": "object",
        "properties": {
          "crewMemberId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "jobs": {
            "type": "integer",
            "format": "int32"
          },
          "setupUnits": {
            "type": "integer",
            "format": "int32"
          },
          "pickupUnits": {
            "type": "integer",
            "format": "int32"
          },
          "totalUnits": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JobCardDto": {
        "required": [
          "jobId",
          "bookingId",
          "jobNumber",
          "type",
          "scheduledAt",
          "truck",
          "status",
          "completedAt",
          "completedBy",
          "isNextUp",
          "customerName",
          "phone",
          "street",
          "cityStateZip",
          "surface",
          "siteNotes",
          "units",
          "extras",
          "crew"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "integer",
            "format": "int32"
          },
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "jobNumber": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "$ref": "#/components/schemas/JobType"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "truck": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedBy": {
            "type": [
              "null",
              "string"
            ]
          },
          "isNextUp": {
            "type": "boolean"
          },
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "cityStateZip": {
            "type": "string"
          },
          "surface": {
            "$ref": "#/components/schemas/Surface"
          },
          "siteNotes": {
            "type": "string"
          },
          "units": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDto"
            }
          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDto"
            }
          },
          "crew": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CrewSummaryDto"
            }
          }
        }
      },
      "JobScheduleDto": {
        "required": [
          "id",
          "scheduledAt",
          "truck",
          "status",
          "crewMemberIds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "truck": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "crewMemberIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "JobStatus": {
        "enum": [
          "Upcoming",
          "Done"
        ]
      },
      "JobType": {
        "enum": [
          "Setup",
          "Pickup"
        ]
      },
      "RouteDayDto": {
        "required": [
          "date",
          "jobs"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobCardDto"
            }
          }
        }
      },
      "SaveBookingItemRequest": {
        "required": [
          "name",
          "isUnit"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 80,
            "type": "string"
          },
          "isUnit": {
            "type": "boolean"
          }
        }
      },
      "SaveBookingRequest": {
        "required": [
          "customerName",
          "phone",
          "street",
          "cityStateZip",
          "surface",
          "siteNotes",
          "setup",
          "pickup",
          "items"
        ],
        "type": "object",
        "properties": {
          "customerName": {
            "maxLength": 100,
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "type": [
              "null",
              "string"
            ]
          },
          "street": {
            "maxLength": 150,
            "type": "string"
          },
          "cityStateZip": {
            "maxLength": 100,
            "type": [
              "null",
              "string"
            ]
          },
          "surface": {
            "$ref": "#/components/schemas/Surface"
          },
          "siteNotes": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "setup": {
            "$ref": "#/components/schemas/SaveJobScheduleRequest"
          },
          "pickup": {
            "$ref": "#/components/schemas/SaveJobScheduleRequest"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SaveBookingItemRequest"
            }
          }
        }
      },
      "SaveCrewMemberRequest": {
        "required": [
          "name",
          "initials",
          "role"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 80,
            "type": "string"
          },
          "initials": {
            "maxLength": 3,
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "SaveJobScheduleRequest": {
        "required": [
          "scheduledAt",
          "truck",
          "crewMemberIds"
        ],
        "type": "object",
        "properties": {
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "truck": {
            "maxLength": 30,
            "type": [
              "null",
              "string"
            ]
          },
          "crewMemberIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "SetItemLoadedRequest": {
        "required": [
          "isLoaded"
        ],
        "type": "object",
        "properties": {
          "isLoaded": {
            "type": "boolean"
          }
        }
      },
      "Surface": {
        "enum": [
          "Grass",
          "Concrete",
          "Gravel",
          "Inside"
        ]
      },
      "UnitTotalsReport": {
        "required": [
          "from",
          "to",
          "crew"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "crew": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CrewUnitTotalsDto"
            }
          }
        }
      }
